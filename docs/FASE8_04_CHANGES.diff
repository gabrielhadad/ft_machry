+openapi: 3.0.3
+info:
+  title: ft_machry API
+  version: "2.0"
+security:
+  - cookieAuth: []
+paths:
+  /api/auth/login:
+    post:
+      summary: Inicia uma sessão
+      tags: [autenticacao]
+      security: []
+      requestBody:
+        required: true
+        content:
+          application/json:
+            schema:
+              type: object
+              required: [username, password]
+              properties:
+                username: {type: string}
+                password: {type: string, format: password}
+      responses:
+        "200":
+          description: Usuário autenticado
+          content:
+            application/json:
+              schema: {$ref: "#/components/schemas/Usuario"}
+        "401": {description: Usuário ou senha inválidos}
+  /api/auth/logout:
+    post:
+      summary: Encerra a sessão atual
+      tags: [autenticacao]
+      responses:
+        "204": {description: Sessão encerrada}
+  /api/auth/me:
+    get:
+      summary: Retorna o usuário da sessão
+      tags: [autenticacao]
+      responses:
+        "200":
+          description: Usuário autenticado
+          content:
+            application/json:
+              schema: {$ref: "#/components/schemas/Usuario"}
+        "401": {description: Autenticação necessária}
+  /api/auth/usuarios:
+    get:
+      summary: Lista usuários; exclusivo da proprietária
+      tags: [autenticacao]
+      responses:
+        "200": {description: Lista de usuários}
+    post:
+      summary: Cria usuário; exclusivo da proprietária
+      tags: [autenticacao]
+      responses:
+        "201": {description: Usuário criado}
+
+  /api/produtos:
+    get:
+      summary: Lista produtos ativos (ordenados por nome)
+      tags: [produtos]
+      responses:
+        "200":
+          description: Lista de produtos
+          content:
+            application/json:
+              schema:
+                type: array
+                items: {$ref: "#/components/schemas/Produto"}
+    post:
+      summary: Cria produto
+      tags: [produtos]
+      requestBody:
+        required: true
+        content:
+          application/json:
+            schema: {$ref: "#/components/schemas/ProdutoCriar"}
+      responses:
+        "201":
+          description: Produto criado
+          content:
+            application/json:
+              schema: {$ref: "#/components/schemas/Produto"}
+        "400": {$ref: "#/components/responses/Invalido"}
+  /api/produtos/{id}:
+    parameters:
+      - {name: id, in: path, required: true, schema: {type: integer}}
+    get:
+      summary: Detalha produto ativo
+      tags: [produtos]
+      responses:
+        "200":
+          description: Produto
+          content:
+            application/json:
+              schema: {$ref: "#/components/schemas/Produto"}
+        "404": {$ref: "#/components/responses/NaoEncontrado"}
+    put:
+      summary: Atualiza produto (parcial, só os campos enviados)
+      tags: [produtos]
+      requestBody:
+        required: true
+        content:
+          application/json:
+            schema: {$ref: "#/components/schemas/ProdutoCampos"}
+      responses:
+        "200":
+          description: Produto atualizado
+          content:
+            application/json:
+              schema: {$ref: "#/components/schemas/Produto"}
+        "400": {$ref: "#/components/responses/Invalido"}
+        "404": {$ref: "#/components/responses/NaoEncontrado"}
+    delete:
+      summary: Desativa produto (exclusão lógica, ativo = 0)
+      tags: [produtos]
+      responses:
+        "204": {description: Produto desativado}
+        "404": {$ref: "#/components/responses/NaoEncontrado"}
+
+  /api/fichas-tecnicas:
+    get:
+      summary: Lista fichas técnicas completas
+      tags: [fichas tecnicas]
+      responses:
+        "200":
+          description: Fichas ordenadas pelo nome do produto resultante
+          content:
+            application/json:
+              schema:
+                type: array
+                items: {$ref: "#/components/schemas/FichaTecnica"}
+    post:
+      summary: Cria ficha técnica com fases e componentes
+      tags: [fichas tecnicas]
+      requestBody:
+        required: true
+        content:
+          application/json:
+            schema: {$ref: "#/components/schemas/FichaTecnicaEntrada"}
+      responses:
+        "201":
+          description: Ficha criada
+          content:
+            application/json:
+              schema: {$ref: "#/components/schemas/FichaTecnica"}
+        "400": {$ref: "#/components/responses/Invalido"}
+        "409": {description: O produto já possui uma ficha}
+
+  /api/fichas-tecnicas/fases:
+    get:
+      summary: Lista o catálogo de fases de produção
+      tags: [fichas tecnicas]
+      responses:
+        "200":
+          description: Fases disponíveis
+
+  /api/fichas-tecnicas/{id}:
+    parameters:
+      - {name: id, in: path, required: true, schema: {type: integer}}
+    get:
+      summary: Detalha uma ficha técnica
+      tags: [fichas tecnicas]
+      responses:
+        "200":
+          description: Ficha completa
+          content:
+            application/json:
+              schema: {$ref: "#/components/schemas/FichaTecnica"}
+        "404": {$ref: "#/components/responses/NaoEncontrado"}
+    put:
+      summary: Substitui dados, fases e componentes da ficha em uma transação
+      tags: [fichas tecnicas]
+      requestBody:
+        required: true
+        content:
+          application/json:
+            schema: {$ref: "#/components/schemas/FichaTecnicaEntrada"}
+      responses:
+        "200":
+          description: Ficha atualizada
+          content:
+            application/json:
+              schema: {$ref: "#/components/schemas/FichaTecnica"}
+        "400": {$ref: "#/components/responses/Invalido"}
+        "404": {$ref: "#/components/responses/NaoEncontrado"}
+        "409": {description: Conflito com outra ficha}
+    delete:
+      summary: Exclui ficha sem histórico de produção
+      tags: [fichas tecnicas]
+      responses:
+        "204": {description: Ficha excluída}
+        "404": {$ref: "#/components/responses/NaoEncontrado"}
+        "409": {description: A ficha já possui solicitações de produção}
+
+  /api/estoque/inventario:
+    get:
+      summary: Lista o inventário atual (view vw_inventario, só lotes com saldo > 0)
+      tags: [estoque]
+      parameters:
+        - {name: produto_id, in: query, schema: {type: integer, minimum: 1}}
+        - {name: lote_id, in: query, schema: {type: integer, minimum: 1}}
+      responses:
+        "200":
+          description: Itens em estoque, ordenados por produto, validade e lote
+          content:
+            application/json:
+              schema:
+                type: array
+                items: {$ref: "#/components/schemas/ItemInventario"}
+        "400": {$ref: "#/components/responses/Invalido"}
+
+  /api/estoque/movimentacoes:
+    get:
+      summary: Lista as movimentações de estoque mais recentes
+      tags: [estoque]
+      parameters:
+        - {name: limite, in: query, schema: {type: integer, minimum: 1, maximum: 500, default: 100}}
+        - {name: lote_id, in: query, schema: {type: integer, minimum: 1}}
+        - {name: usuario_id, in: query, schema: {type: integer, minimum: 1}}
+        - {name: tipo, in: query, schema: {type: string}, description: "Comparado em maiúsculas; sem validação contra o enum"}
+      responses:
+        "200":
+          description: Movimentações, mais recentes primeiro
+          content:
+            application/json:
+              schema:
+                type: array
+                items: {$ref: "#/components/schemas/Movimentacao"}
+        "400": {$ref: "#/components/responses/Invalido"}
+    post:
+      summary: Registra uma movimentação e atualiza o saldo na mesma transação
+      tags: [estoque]
+      requestBody:
+        required: true
+        content:
+          application/json:
+            schema: {$ref: "#/components/schemas/MovimentacaoCriar"}
+      responses:
+        "201":
+          description: Movimentação registrada
