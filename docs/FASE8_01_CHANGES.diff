+def test_lista_e_detalhe_com_dados(seeded_client):
+    c = seeded_client
+    criada = _criar_solicitacao(c)
+    solicitacao_id = criada["id"]
+
+    # Exercita também a máquina de estados pública da produção.
+    atualizada = c.put(
