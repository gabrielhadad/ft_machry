# Ambiente: development | production
APP_ENV=development

# Banco local rápido (opcional)
#DB_CONNECTION=sqlite
#DATABASE_PATH=data/app.db

# PostgreSQL recomendado para desenvolvimento integrado e obrigatório em produção.
DB_CONNECTION=postgresql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=ft_machry
DB_USERNAME=machry
DB_PASSWORD=troque-a-senha-do-banco

FLASK_DEBUG=0
FRONTEND_PORT=8080

# Em produção: use uma chave aleatória com 32+ caracteres e HTTPS.
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria-com-32-caracteres-ou-mais
SESSION_COOKIE_SECURE=0
SESSION_LIFETIME_MINUTES=480
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

# Contas bootstrap. Troque TODAS as senhas antes de APP_ENV=production.
OWNER_USERNAME=dona
OWNER_INITIAL_PASSWORD=TroqueOwner@123
MANAGER_USERNAME=gestor
MANAGER_INITIAL_PASSWORD=TroqueGestor@123
COOK_USERNAME=cozinha
COOK_INITIAL_PASSWORD=TroqueCozinha@123
